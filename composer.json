{
  "name": "laravel/laravel",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.1",
    "advmaker/carbon-period": "^0.2.2",
    "anhskohbo/no-captcha": "^3.6",
    "barryvdh/laravel-dompdf": "^1.0.0",
    "doctrine/dbal": "^2.13",
    "fideloper/proxy": "^4.4",
    "fruitcake/laravel-cors": "^3.0",
    "guzzlehttp/guzzle": "^7.9",
    "laravel/cashier": "^13.17",
    "laravel/framework": "^8.0",
    "laravel/legacy-factories": "^1.4",
    "laravel/nexmo-notification-channel": "^2.4",
    "laravel/tinker": "^2.10",
    "laravel/ui": "^3.0",
    "qlick/laravel-full-calendar": "~1.0",
    "spatie/laravel-honeypot": "^4.5",
    "spatie/laravel-newsletter": "^4.11"
  },
  "require-dev": {
    "facade/ignition": "^2.17",
    "filp/whoops": "~2.0",
    "fzaninotto/faker": "^1.9.1",
    "laravel/dusk": "^6.0",
    "laravel/telescope": "^5.3",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^5.0",
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "classmap": [
      "database/seeders",
      "database/factories"
    ],
    "exclude-from-classmap": [
      "app/Providers/TelescopeServiceProvider.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
